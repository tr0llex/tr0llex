# Кеш интерпретатора рядом с assets/og.py.
#
# Заводится сам при каждом запуске генератора карточек и попадал в git status
# как неотслеживаемый мусор — на фоне которого легко не заметить настоящую
# правку. Сами карточки (assets/og.png и assets/og/*.png) отслеживаются
# намеренно: их отдаёт GitHub в превью профиля, и пересобирать их на чужой
# машине незачем.
__pycache__/
*.pyc
